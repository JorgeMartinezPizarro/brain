## BRAIN CONFIGURATION EXAMPLE
## ===========================

## Docker registry config
## Leave DOCKER_REGISTRY empty to use Docker Hub, or set it to a private registry host (e.g. registry.example.com)
DOCKER_REGISTRY=
DOCKER_HUB_USER=youruser
DOCKER_HUB_PROJECT=sdasdadsa
PROJECT_NAME=saddsadsa
## Data folder: volumes live in $DATA_DIR/volumes, outside the repo
DATA_DIR=/srv/${PROJECT_NAME}
## Web ports
WORDPRESS_PORT=2313
NEXTCLOUD_PORT=4123
MATRIX_PORT=9832
## Nextcloud setup
NEXT_PUBLIC_NEXTCLOUD_URL=https://yoururl
NEXTCLOUD_DOMAIN=domain
NEXTCLOUD_ADMIN_USER=user
NEXTCLOUD_ADMIN_PASSWORD=pass
## Nextcloud database (mariadb)
NEXTCLOUD_DB_ROOT_PASSWORD=changeme
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=changeme
NEXTCLOUD_DB_NAME=nextcloud
## Wordpress setup
WORDPRESS_SITE_URL=https://url2
WORDPRESS_ADMIN_USER=user2
WORDPRESS_ADMIN_PASSWORD=pass2
WORDPRESS_ADMIN_EMAIL=your@mail.com
## Wordpress database (mysql)
MYSQL_ROOT_PASSWORD=changeme
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=changeme
WORDPRESS_DB_NAME=wordpress
## Matrix credencials
SMTP_PASS=sadjoasjlksadljkjlk3
MATRIX_URL=your-url